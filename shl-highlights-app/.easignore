# EAS Build ignore file
# This overrides .gitignore for EAS builds
# We need to include google-services.json and GoogleService-Info.plist for builds

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# Firebase config. These are gitignored and therefore untracked, so omitting
# them above is not enough -- an untracked file needs an explicit `!` negation
# (and it must come last) or EAS strips it from the uploaded archive and
# scripts/eas-build-pre-install.js fails the Pre-install hook phase.
!google-services.json
!GoogleService-Info.plist
